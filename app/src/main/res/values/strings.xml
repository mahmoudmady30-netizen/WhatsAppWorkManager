    <!-- Privacy -->
    <string name="privacy_title">Privacy &amp; Data</string>
    <string name="privacy_body">
        This app needs Notification Access to read the WhatsApp notifications that already
        appear on your device. It does not read your chat database, does not use Accessibility
        Services, does not use root, and does not attempt to modify WhatsApp\'s read-receipt or
        online-status behavior in any way.\n\n
        By default, all captured data stays on this device inside a local, private database.
        Nothing is sent to any server.\n\n
        If you enable an AI Cloud Summary provider, the text of your messages will be sent to
        that provider to generate a summary. You will see a clear warning before this is enabled.
        You can turn it off at any time and use the on-device rule-based summary instead.
    </string>
    <string name="privacy_clear_data_confirm">This will permanently delete all stored messages, groups, and summaries. This cannot be undone.</string>

