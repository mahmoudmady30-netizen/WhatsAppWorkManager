# Copy this file to "keystore.properties" (same folder as this sample) and fill in your
# real values. keystore.properties is git-ignored and is NEVER read into the APK — Gradle
# only uses it at build time to sign the release artifact.
#
# Generate a keystore first, if you don't already have one:
#   keytool -genkeypair -v -keystore release-key.jks -alias wwm -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile below at wherever you saved that .jks file (absolute path, or a path
# relative to the project root).

storeFile=release-key.jks
storePassword=CHANGE_ME
keyAlias=wwm
keyPassword=CHANGE_ME
